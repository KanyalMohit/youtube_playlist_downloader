{
  "name": "youtube_playlist_downloader",
  "version": "1.0.0",
  "author": "Mohit Kanyal",
  "description": "A desktop application for downloading YouTube playlists as audio files (MP3 or WebM). Perfect for personal use by musicians, beatmakers, or hobbyists who want to download free-to-use YouTube beats for practice, remixing, or sampling.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "cross-env USE_HARD_LINKS=false ELECTRON_BUILDER_DISABLE_MIRROR=true electron-builder --win --x64"
  },
  "build": {
    "appId": "com.mohitkanyal.ytplaylistdownloader",
    "productName": "YouTube Playlist Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "bin/yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "bin/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.1.0",
    "yt-dlp-wrap": "^2.3.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^23.6.0"
  }
}
